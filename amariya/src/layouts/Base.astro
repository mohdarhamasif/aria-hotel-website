---
import { Font } from 'astro:assets';
import { colors, type ThemeKey } from '../data/colors';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  theme: ThemeKey;
  /** Font CSS variables this page needs beyond the body and brand faces (see astro.config.mjs) */
  fonts: string[];
  /** Absolute URL or a path on this site; defaults to the current path */
  canonical?: string;
  /** Path or URL of the 1200 × 630 share image */
  ogImage?: string;
  ogAlt?: string;
  jsonLd?: object | null;
  noindex?: boolean;
}
const { title, description, theme, fonts, canonical, ogImage, ogAlt, jsonLd = null, noindex = false } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const url = new URL(canonical ?? Astro.url.pathname, site).href;
const image = ogImage ? new URL(ogImage, site).href : null;
// Greeting faces are only for a few words: never preloaded. Bona Nova's latin-ext file loads only when a page needs it.
const LAZY = new Set(['--font-arabic', '--font-jp']);
const preloadOf = (v: string) => (LAZY.has(v) ? false : v === '--font-display-hospitality' ? [{ subset: 'latin' }] : true);
// '<' escaped so no string in the data can close the script element
const ld = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
---
<!doctype html>
<html lang="en" data-theme={theme} data-motion="on">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      // Motion state before first paint, so a remembered Pause never flickers (motion/prefs.ts takes over)
      (function () {
        var d = document.documentElement, paused = false;
        try { paused = localStorage.getItem('amariya_motion') === 'paused'; } catch (e) {}
        d.dataset.motion = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'reduced' : paused ? 'paused' : 'on';
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
    <meta name="theme-color" content={colors[theme]['bg-page']} />
    <meta name="color-scheme" content={theme === 'hospitality' ? 'dark' : 'light'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Amariya" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    {image && <meta property="og:image" content={image} />}
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    {image && ogAlt && <meta property="og:image:alt" content={ogAlt} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    {image && ogAlt && <meta name="twitter:image:alt" content={ogAlt} />}

    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-brand" />
    {fonts.map((cssVariable) => <Font cssVariable={cssVariable as any} preload={preloadOf(cssVariable)} />)}
    {ld && <script type="application/ld+json" set:html={ld} />}
    <slot name="head" />
  </head>
  <body>
    <slot name="skip" />
    <slot />
  </body>
</html>
