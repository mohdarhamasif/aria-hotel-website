---
interface Props {
  links: { href: string; label: string }[];
}
const { links } = Astro.props;
---
<div class="skip-links">
  {links.map((l) => <a href={l.href}>{l.label}</a>)}
</div>

<style>
  :where(.skip-links a) {
    position: fixed; top: 8px; left: 8px; z-index: calc(var(--z-toast) + 1); display: inline-flex; align-items: center; min-height: var(--target); padding: 0 18px;
    border-radius: 999px; background: var(--color-accent-solid); color: var(--color-accent-ink); font-weight: 500; text-decoration: none;
    transform: translateY(-160%); transition: transform var(--dur-micro) var(--ease-out);
  }
  :where(.skip-links a:focus) { transform: none; }
</style>
