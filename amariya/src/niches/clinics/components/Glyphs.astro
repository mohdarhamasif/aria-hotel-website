---
// The six feature glyphs and the control icons: one 1px stroke on a 24px grid, round caps.
// Used as <svg class="glyph"><use href="#g-answering" /></svg>; colour and stroke come from .glyph in clinics.css.
---
<svg class="glyph-sprite" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <!-- answering: a receiver arc -->
    <symbol id="g-answering" viewBox="0 0 24 24"><path d="M4 10.4c4.4-4.5 11.6-4.5 16 0" /><path d="M4 10.4l2.6 2.6 2.3-2.2-1.1-2.8" /><path d="M20 10.4l-2.6 2.6-2.3-2.2 1.1-2.8" /></symbol>
    <!-- bookings: a slot with a tick -->
    <symbol id="g-bookings" viewBox="0 0 24 24"><rect x="4" y="6" width="16" height="12.5" rx="2" /><path d="M4 9.5h16" /><path d="M9 14l2.1 2.1 4-4.2" /></symbol>
    <!-- multilingual: two overlapping arcs -->
    <symbol id="g-multilingual" viewBox="0 0 24 24"><path d="M4.5 15.6a5.6 5.6 0 1 1 9.4-4.1" /><path d="M19.5 8.4a5.6 5.6 0 1 1-9.4 4.1" /></symbol>
    <!-- guest_requests: a ring with an arrow stopping at a bar (handed to the team at the line) -->
    <symbol id="g-guest_requests" viewBox="0 0 24 24"><circle cx="6.5" cy="12" r="3" /><path d="M9.5 12h7.5" /><path d="M14.6 9.6 17 12l-2.4 2.4" /><path d="M20 5.5v13" /></symbol>
    <!-- upsells: a circular arrow with a dot (the recall) -->
    <symbol id="g-upsells" viewBox="0 0 24 24"><path d="M18.4 12a6.4 6.4 0 1 1-1.9-4.5" /><path d="M17.2 4.6v3.2H14" /><circle cx="12" cy="12" r="1.1" class="glyph-dot" fill="currentColor" stroke="none" /></symbol>
    <!-- integrations: two linked rings -->
    <symbol id="g-integrations" viewBox="0 0 24 24"><circle cx="9.2" cy="12" r="4.4" /><circle cx="14.8" cy="12" r="4.4" /></symbol>

    <symbol id="g-mic" viewBox="0 0 24 24"><rect x="9" y="3.5" width="6" height="10.5" rx="3" /><path d="M5.8 11.6a6.2 6.2 0 0 0 12.4 0" /><path d="M12 17.8v2.7" /></symbol>
    <symbol id="g-mute" viewBox="0 0 24 24"><rect x="9" y="3.5" width="6" height="10.5" rx="3" /><path d="M5.8 11.6a6.2 6.2 0 0 0 12.4 0" /><path d="M12 17.8v2.7" /><path d="M4.5 4.5l15 15" /></symbol>
    <symbol id="g-switch" viewBox="0 0 24 24"><path d="M4.5 8.5h13l-3-3" /><path d="M19.5 15.5h-13l3 3" /></symbol>
    <symbol id="g-type" viewBox="0 0 24 24"><rect x="3.5" y="6.5" width="17" height="11" rx="2" /><path d="M7 10.5h.01M10.3 10.5h.01M13.7 10.5h.01M17 10.5h.01M8 14h8" /></symbol>
    <symbol id="g-sound" viewBox="0 0 24 24"><path d="M4.5 9.6h3l4-3.4v11.6l-4-3.4h-3z" /><path d="M15 9.2a4 4 0 0 1 0 5.6" /><path d="M17.6 6.6a7.6 7.6 0 0 1 0 10.8" /></symbol>
    <symbol id="g-pause" viewBox="0 0 24 24"><path d="M9 6.5v11M15 6.5v11" /></symbol>
    <symbol id="g-close" viewBox="0 0 24 24"><path d="M6.5 6.5l11 11M17.5 6.5l-11 11" /></symbol>
    <symbol id="g-notes" viewBox="0 0 24 24"><path d="M6.5 4.5h8l3 3v12h-11z" /><path d="M9 11h6M9 14.5h6" /></symbol>
    <symbol id="g-index" viewBox="0 0 24 24"><path d="M12 3.5v4.5c0 2-2.5 2-2.5 4s2.5 2 2.5 4v4.5" /><circle cx="12" cy="3.5" r=".9" class="glyph-dot" fill="currentColor" stroke="none" /><circle cx="12" cy="20.5" r=".9" class="glyph-dot" fill="currentColor" stroke="none" /></symbol>
  </defs>
</svg>
